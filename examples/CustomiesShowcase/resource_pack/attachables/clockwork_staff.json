{
  "format_version": "1.20.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "showcase:clockwork_staff",
      "item": {
        "showcase:clockwork_staff": "query.is_owner_identifier_any('minecraft:player')"
      },
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/models/clockwork_staff",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.showcase.clockwork_staff"
      },
      "animations": {
        "controller": "controller.animation.showcase.held",
        "idle": "animation.showcase.clockwork_staff.idle",
        "first_person": "animation.showcase.clockwork_staff.first_person",
        "third_person": "animation.showcase.clockwork_staff.third_person"
      },
      "scripts": {
        "animate": [
          "controller"
        ]
      },
      "render_controllers": [
        "controller.render.showcase.gear"
      ]
    }
  }
}
